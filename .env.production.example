# ---- calcal production env ----
# Public https URL (no trailing slash)
APP_URL=https://calcal.example.com

# 32+ random bytes: openssl rand -hex 32
APP_SECRET=replace-with-openssl-rand-hex-32

# SQLite on a persistent volume (Docker: /app/data)
DATABASE_PATH=/app/data/app.db

# Protects /api/cron/reminders (run every minute)
CRON_SECRET=replace-with-random-secret

# Email delivery (optional: without it emails stay in the outbox)
RESEND_API_KEY=
MAIL_FROM="calcal <notifications@your-domain.com>"

# Google Calendar OAuth (optional)
# Register redirect URI: ${APP_URL}/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Checkout (optional)
# Register webhook endpoint: ${APP_URL}/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
